{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "IS_PRODUCTION",
        "PORT",
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_TRAINTO_CHAT_ID",
        "GMAIL_SMTP_ID",
        "GMAIL_SMTP_PASSWORD",
        "SECRET",
        "API_KEY_GITHUB"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
